# Get a free access key at https://web3forms.com (sign up with the inbox that should receive
# quote/contact/career submissions). Paste it below for local dev (.env.local), and add the same
# variable in Vercel: Project -> Settings -> Environment Variables.
WEB3FORMS_ACCESS_KEY=

# Optional: your production domain, used for SEO metadata/sitemap (defaults to tripplekeng.com if unset)
NEXT_PUBLIC_SITE_URL=https://www.tripplekeng.com
