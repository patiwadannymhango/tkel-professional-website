# Get a free access key at https://web3forms.com (sign up with the inbox that should receive
# quote/contact/career submissions). Web3Forms's free plan only accepts submissions sent directly
# from the browser, so this form calls Web3Forms client-side — the access key ships in the public
# bundle by design (Web3Forms relies on domain restriction + honeypot for spam control, not key
# secrecy). Paste it below for local dev (.env.local), and add the same variable in Vercel:
# Project -> Settings -> Environment Variables. Must be prefixed NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Your production domain, used for SEO metadata/sitemap (defaults to tripplekeng.com if unset)
NEXT_PUBLIC_SITE_URL=https://www.tripplekeng.com
